# Server Port
PORT=5000

# PostgreSQL Connection
# You can use a full connection string (e.g. from Supabase, Neon, or local):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/sheworks
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sheworks

# Or individual connection params:
# PGUSER=postgres
# PGPASSWORD=yourpassword
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=sheworks
